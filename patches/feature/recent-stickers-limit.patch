diff --git a/submodules/TelegramCore/Sources/State/SynchronizeChatInputStateOperation.swift b/submodules/TelegramCore/Sources/State/SynchronizeChatInputStateOperation.swift
index 0000000..0000000 100644
--- a/submodules/TelegramCore/Sources/State/SynchronizeChatInputStateOperation.swift
+++ b/submodules/TelegramCore/Sources/State/SynchronizeChatInputStateOperation.swift
@@ -7,6 +7,44 @@ public enum ClearHooks {
     public static let expandedMessageIds = Atomic<Set<MessageId>>(value: Set())
     public static let fasterFileLoad = Atomic<Bool>(value: false)
     public static let hideStories = Atomic<Bool>(value: false)
+    // 0 = stock (Telegram's hardcoded recent-sticker cap of 20).
+    public static let recentStickersLimit = Atomic<Int32>(value: 0)
+}
+
+// Cleargram: the cap passed to `removeTailIfCountExceeds` for the cloud recent-sticker list.
+// Never shrinks below the stock value, so a configured value smaller than 20 cannot make the
+// list shorter than stock.
+func clearRecentStickersCap(_ stockValue: Int) -> Int {
+    let configured = Int(ClearHooks.recentStickersLimit.with({ $0 }))
+    return configured > stockValue ? configured : stockValue
+}
+
+// Cleargram: a cloud sync replaces the whole ordered list with the server's copy, which the server
+// truncates to `stickers_recent_limit`. Re-append the locally known stickers the server dropped,
+// behind the server's own ones, up to the configured cap.
+func clearMergeLocalRecentStickers(
+    transaction: Transaction,
+    collectionId: Int32,
+    items: inout [OrderedItemListEntry],
+    existingIds: inout Set<Data>
+) {
+    guard collectionId == Namespaces.OrderedItemList.CloudRecentStickers else {
+        return
+    }
+    let limit = Int(ClearHooks.recentStickersLimit.with({ $0 }))
+    guard limit > items.count else {
+        return
+    }
+    for entry in transaction.getOrderedListItems(collectionId: collectionId) {
+        if items.count >= limit {
+            break
+        }
+        let id = entry.id.makeData()
+        if !existingIds.contains(id) {
+            existingIds.insert(id)
+            items.append(entry)
+        }
+    }
 }
 
