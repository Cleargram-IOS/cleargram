     private func maxDimensions(additional: Bool, preferWide: Bool) -> CMVideoDimensions {
         if self.isRoundVideo && self.exclusive {
+            // Cleargram: quality mode captures at 1440x1080 — a 4:3 shape, so the square кружок crop
+            // stays wide, and downscaled to the stock 400 output it looks the same. The larger
+            // readout is what lets the back sensor actually sustain 60 fps: at stock 640x480 it can
+            // only deliver ~24 (readout limit at that binning), while 1440x1080 reaches 60. Stock
+            // (30 fps) keeps 640x480.
+            if ClearHooks.improveRoundVideoQuality.with({ $0 }) {
