     private func preferredMaxFrameRate(useLower: Bool) -> Double {
+        // Cleargram: round video is pinned to 30 by stock, both here and via the
+        // preferLowerFramerate flag its callers force on. Lift both when the quality toggle is on,
+        // but only for the single-camera (exclusive) case — in dual-camera mode two capture devices
+        // run at once and stock's 30 is load-bearing.
+        if self.isRoundVideo && self.exclusive && ClearHooks.improveRoundVideoQuality.with({ $0 }) {
+            return 60.0
+        }
         if !self.exclusive || self.isRoundVideo || useLower {
