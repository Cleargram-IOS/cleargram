+    func shouldWarnPollRevote(id: MessageId, opaqueIdentifiers: [Data]) -> Bool {
+        if clearPollRevoteSkip.with({ $0.contains(id) }) {
+            let _ = clearPollRevoteSkip.modify { current -> Set<MessageId> in
+                var updated = current
+                updated.remove(id)
+                return updated
+            }
+            return false
+        }
+        guard let msg = self.chatDisplayNode.historyNode.messageInCurrentHistoryView(id)?._asMessage(),
+              let poll = msg.media.first(where: { $0 is TelegramMediaPoll }) as? TelegramMediaPoll,
+              let voters = poll.results.voters,
+              voters.contains(where: { $0.selected }) else {
+            return false
+        }
+        let currentSelected = Set(voters.filter { $0.selected }.map { $0.opaqueIdentifier })
+        if currentSelected == Set(opaqueIdentifiers) {
+            return false
+        }
+        let _ = clearPollRevoteSkip.modify { current -> Set<MessageId> in
+            var updated = current
+            updated.insert(id)
+            return updated
+        }
+        return true
+    }
