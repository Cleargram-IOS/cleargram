+            // every device has, whereas 720p60 is; without one in the candidate set the format
+            // search finds nothing to pin and `actualFPS` clamps back to 30.
+            if clearRoundVideoRecordingSide() > 400 || ClearHooks.roundVideo60Fps.with({ $0 }) {
+                return CMVideoDimensions(width: 1280, height: 720)
+            }
             return CMVideoDimensions(width: 640, height: 480)
         } else {
             if additional || preferWide {
@@ -98,6 +106,13 @@ final class CameraDeviceContext {
     }
     
     private func preferredMaxFrameRate(useLower: Bool) -> Double {
+        // Cleargram: round video is pinned to 30 by stock, both here and via the
+        // `preferLowerFramerate` flag its callers force on. Lift both when the toggle is on —
+        // but only for the single-camera case, matching the ceiling in `maxDimensions` above:
+        // in dual-camera mode two capture devices run at once and stock's 30 is load-bearing.
+        if self.isRoundVideo && self.exclusive && ClearHooks.roundVideo60Fps.with({ $0 }) {
+            return 60.0
+        }
         if !self.exclusive || self.isRoundVideo || useLower {
             return 30.0
         }
