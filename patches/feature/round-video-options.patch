--- a/submodules/TelegramCore/Sources/State/SynchronizeChatInputStateOperation.swift
+++ b/submodules/TelegramCore/Sources/State/SynchronizeChatInputStateOperation.swift
@@ -9,6 +9,20 @@ public enum ClearHooks {
     public static let hideStories = Atomic<Bool>(value: false)
     // 0 = stock (Telegram's hardcoded recent-sticker cap of 20).
     public static let recentStickersLimit = Atomic<Int32>(value: 0)
+    // Round video messages. The Camera submodule can't see TelegramUIPreferences, so these
+    // three mirror ClearConfig for it.
+    public static let roundVideo60Fps = Atomic<Bool>(value: false)
+    // Side of the recorded square, in pixels. 0 = stock (400).
+    public static let roundVideoSide = Atomic<Int32>(value: 0)
+    public static let roundVideoKeepCorners = Atomic<Bool>(value: false)
+}
+
+// Cleargram: stock records кружки as a 400x400 square. A larger side is only a recording
+// constant — nothing in the protocol fixes it, and receiving clients scale whatever arrives
+// into their own circle — so raising it just makes the кружок sharper on the other end.
+public func clearRoundVideoRecordingSide() -> Int32 {
+    let configured = ClearHooks.roundVideoSide.with({ $0 })
+    return configured > 0 ? configured : 400
 }
 
 // Cleargram: the cap passed to `removeTailIfCountExceeds` for the cloud recent-sticker list.
