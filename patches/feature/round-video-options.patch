     private func maxDimensions(additional: Bool, preferWide: Bool) -> CMVideoDimensions {
         if self.isRoundVideo && self.exclusive {
+            // Cleargram: stock caps round-video capture at 640x480, which is only just enough
+            // for the 400x400 crop. A larger recorded side needs a larger source — and so does
