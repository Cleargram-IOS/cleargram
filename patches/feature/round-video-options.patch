diff --git a/submodules/Camera/Sources/CameraDevice.swift b/submodules/Camera/Sources/CameraDevice.swift
index 0000000..0000000 100644
--- a/submodules/Camera/Sources/CameraDevice.swift
+++ b/submodules/Camera/Sources/CameraDevice.swift
@@ -133,6 +133,19 @@ final class CameraDevice {
                 if bestFormat == nil {
                     bestFormat = candidates.last
                 }
+                // Cleargram: stock takes the last candidate whose ranges all fit under
+                // maxFramerate, so 30fps formats stay eligible when the ceiling is raised and
+                // the pick is effectively arbitrary — `actualFPS` would then clamp back to 30
+                // and the toggle would silently do nothing. Above stock's 30, insist on a
+                // format that actually reaches the ceiling.
+                if maxFramerate > 30.0 {
+                    let reachesCeiling: (AVCaptureDevice.Format) -> Bool = { format in
+                        return format.videoSupportedFrameRateRanges.contains(where: { $0.maxFrameRate >= maxFramerate })
+                    }
+                    if let format = photoCandidates.last(where: reachesCeiling) ?? candidates.last(where: reachesCeiling) {
+                        bestFormat = format
+                    }
+                }
                 device.activeFormat = bestFormat!
                     
                 Logger.shared.log("Camera", "Selected format:")
