+import TelegramUIPreferences
 
 public func navigateToChatControllerImpl(_ params: NavigateToChatControllerParams) {
+    let hiddenSettings = (params.context.sharedContext.accountManager.sharedData(keys: [ApplicationSpecificSharedDataKeys.hiddenChatsSettings])
+    |> take(1)
+    |> map { sharedData -> HiddenChatsSettings in
+        return sharedData.entries[ApplicationSpecificSharedDataKeys.hiddenChatsSettings]?.get(HiddenChatsSettings.self) ?? .defaultSettings
+    })
+    let _ = (hiddenSettings |> deliverOnMainQueue).start(next: { settings in
+        if settings.isHidden(params.chatLocation.peerId) {
+            return
+        }
+        navigateToChatControllerImplUnchecked(params)
+    })
+}
+
+private func navigateToChatControllerImplUnchecked(_ params: NavigateToChatControllerParams) {
     if case let .peer(peer) = params.chatLocation {
         let _ = params.context.engine.peers.ensurePeerIsLocallyAvailable(peer: peer).startStandalone()
     }
