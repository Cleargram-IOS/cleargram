diff --git a/submodules/ChatListUI/Sources/ChatListController.swift b/submodules/ChatListUI/Sources/ChatListController.swift
index 0000000..0000000 100644
--- a/submodules/ChatListUI/Sources/ChatListController.swift
+++ b/submodules/ChatListUI/Sources/ChatListController.swift
@@ -6154,6 +6154,12 @@ public class ChatListControllerImpl: TelegramBaseController, ChatListController
     }
     
     private func schedulePeerChatRemoval(peer: EngineRenderedPeer, type: InteractiveMessagesDeletionType, deleteGloballyIfPossible: Bool, completion: @escaping () -> Void) {
+        ClearBiometricHelper.gate(reason: "Confirm delete chat", enabled: ClearConfig.biometricConfirmDeleteChat) { [weak self] in
+            self?.schedulePeerChatRemovalImpl(peer: peer, type: type, deleteGloballyIfPossible: deleteGloballyIfPossible, completion: completion)
+        }
+    }
+
+    private func schedulePeerChatRemovalImpl(peer: EngineRenderedPeer, type: InteractiveMessagesDeletionType, deleteGloballyIfPossible: Bool, completion: @escaping () -> Void) {
         guard let chatPeer = peer.peers[peer.peerId] else {
             return
         }
