@@ -3,9 +3,40 @@ import TelegramPresentationData
 import AccountContext
 import ChatPresentationInterfaceState
 import SwiftSignalKit
+import Postbox
 import TelegramCore
+import TelegramUIPreferences
 
 extension ChatControllerImpl {    
+    // Wraps engine.searchMessages, dropping locally-hidden messages from the results and decrementing
+    // the loaded-page count, so hidden messages never surface in in-chat search (list, count, next/prev nav).
+    func searchMessagesFilteringHidden(location: SearchMessagesLocation, query: String, state: SearchMessagesState?, limit: Int32 = 100) -> Signal<(SearchMessagesResult, SearchMessagesState), NoError> {
+        let hiddenMessageIdsSignal: Signal<Set<MessageId>, NoError> = self.context.sharedContext.accountManager.sharedData(keys: [ApplicationSpecificSharedDataKeys.hiddenMessagesSettings])
+        |> map { sharedData -> Set<MessageId> in
+            let settings = sharedData.entries[ApplicationSpecificSharedDataKeys.hiddenMessagesSettings]?.get(HiddenMessagesSettings.self) ?? .defaultSettings
+            return settings.hiddenMessageIdSet
+        }
+        |> distinctUntilChanged
+
+        return combineLatest(
+            self.context.engine.messages.searchMessages(location: location, query: query, state: state, limit: limit),
+            hiddenMessageIdsSignal
+        )
+        |> map { result, hiddenIds -> (SearchMessagesResult, SearchMessagesState) in
+            let (r, s) = result
+            if hiddenIds.isEmpty {
+                return (r, s)
+            }
+            let filtered = r.messages.filter { !hiddenIds.contains($0.id) }
+            if filtered.count == r.messages.count {
+                return (r, s)
+            }
+            let removed = Int32(r.messages.count - filtered.count)
+            let newResult = SearchMessagesResult(messages: filtered, readStates: r.readStates, threadInfo: r.threadInfo, totalCount: max(0, r.totalCount - removed), completed: r.completed)
+            return (newResult, s)
+        }
+    }
+
     func updateSearch(_ interfaceState: ChatPresentationInterfaceState) -> ChatPresentationInterfaceState? {
         guard let peerId = self.chatLocation.peerId else {
             return nil
